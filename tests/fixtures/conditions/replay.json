{
  "havne_conditions": 1,
  "name": "Engine start",
  "notes": "Synthetic: written for Havne's tests, judged on the replay fixture's engine start under obd2",
  "conditions": [
    {
      "key": "running",
      "name": "Engine running",
      "when": { "signal": ["id:1001", "obd2.rpm"], "unit": "RPM", "above": 500, "clear": 300 },
      "alert": { "level": "warning", "banner": true },
      "mark": true
    },
    {
      "key": "turning",
      "name": "Engine turning for a second",
      "when": { "signal": ["obd2.rpm"], "unit": "RPM", "above": 100 },
      "for": 1
    },
    {
      "key": "rpm_fresh",
      "name": "Engine speed read twice a second",
      "when": { "signal": ["obd2.rpm"], "unit": "RPM", "below": 9000, "max_age": 0.5 }
    },
    {
      "key": "link",
      "name": "Link fault",
      "when": { "link": "not_ok" },
      "record": { "before": 10, "after": 10 }
    }
  ]
}
