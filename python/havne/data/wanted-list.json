{
  "wanted_list": 1,
  "recognizers": {
    "linear_fit": "value = a x raw + b against a reference, with R squared and a plausible a",
    "temperature": "equals ambient after a cold soak (the offset per encoding), then a slow, monotone, bounded warm-up; oil and transmission fluid lag coolant, intake air doesn't",
    "pair": "a commanded and an actual field that track each other, the commanded one leading",
    "siblings": "near-identical fields of one encoding, one for each cylinder or bank",
    "steps": "zero most of the time, signed steps under high load, recovering in steps",
    "ratio_clusters": "rpm over road speed clusters into ratios, and a small integer steps with them",
    "slow_adaptation": "slow-moving and bounded, stepping after events and recovering over minutes",
    "prompt": "a bit that flips with exactly one prompted action",
    "derived": "a formula of references (duty = pulse x rpm / 120000)",
    "engine_off_zero": "zero with the engine off, rising with rpm"
  },
  "conditions": {
    "cold_start": "parked 6 h or more, then started and driven for 15 min",
    "warm_idle": "idling at operating temperature",
    "cruise": "steady road speed in top gear",
    "city": "stops, pull-aways and every gear",
    "rpm_sweep": "a slow rise from idle to high rpm, parked or in gear",
    "load_steps": "moderate throttle steps in one gear",
    "load_pull": "a full-load pull through a gear, on a dyno or a closed course only, at the owner's discretion",
    "parked_prompts": "parked, engine running or off, each action when prompted",
    "several_drives": "several drives on different days",
    "any_drive": "any drive"
  },
  "packs": [
    {
      "key": "tuning",
      "name": "Tuning",
      "signals": [
        {"key": "engine_speed", "name": "Engine speed", "unit": "RPM", "class": "speed", "range": [0, 9000],
