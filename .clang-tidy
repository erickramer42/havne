# clang-tidy's checks for core/, surrogate/ and cli/: scripts/tidy.sh,
# and the clang-tidy job in CI, which fails on any warning. The families
# that find bugs run whole: clang-analyzer (the static analyzer),
# bugprone, concurrency, performance and portability, plus a few misc
# checks of the same kind. The style families (readability, modernize,
# cppcoreguidelines) stay off: the public and J2534 headers must compile
# as C, and the tree isn't written to them. Three style checks earn their
# place: google-explicit-constructor (a one-argument constructor that
# converts silently); readability-braces-around-statements for a body
# on the line after its if, else, for or while, where a second line
# added under it would run unconditionally (ShortStatementLines 1: a
# one-line "if (x) return;" stays as written); and
# google-readability-casting, since a C-style cast in C++ falls through
# to reinterpret_cast or drops const where static_cast would refuse to
# compile. It reads C++ only: the headers that compile as C keep their C
# casts behind a NOLINTBEGIN with that reason.
#
# Turned off, and why:
#   bugprone-easily-swappable-parameters     the C ABI's flat functions
#       take neighboring parameters of one type by design
#   bugprone-implicit-widening-of-multiplication-result   flags "i * 8"
#       offsets in the C headers, whose operands are bounded
#   bugprone-inc-dec-in-conditions           the CSV parsers' "*p++ != ','"
#       runs after a short-circuit, which is well defined
#   bugprone-throwing-static-initialization  the static signal tables; an
#       allocation that fails while the library loads is fatal either way
#   performance-enum-size                    enum sizes are part of the ABI
#
# A warning that is right in general and wrong at one line gets a
# NOLINTNEXTLINE(check) with the reason beside it, never a wider exclusion.
Checks: >-
  -*,
  bugprone-*,
  clang-analyzer-*,
  concurrency-*,
  performance-*,
  portability-*,
  misc-misplaced-const,
  misc-new-delete-overloads,
  misc-redundant-expression,
  misc-throw-by-value-catch-by-reference,
  misc-unconventional-assign-operator,
  misc-uniqueptr-reset-release,
  misc-unused-using-decls,
  readability-misleading-indentation,
  readability-braces-around-statements,
  google-explicit-constructor,
  google-readability-casting,
  -bugprone-easily-swappable-parameters,
  -bugprone-implicit-widening-of-multiplication-result,
  -bugprone-inc-dec-in-conditions,
  -bugprone-throwing-static-initialization,
  -performance-enum-size
WarningsAsErrors: '*'
CheckOptions:
  readability-braces-around-statements.ShortStatementLines: 1
HeaderFilterRegex: '.*[/\\](core|surrogate|cli)[/\\].*'
