# Shell scripts run under Linux (WSL, CI) and Git Bash: LF in every
# checkout, a Windows one with core.autocrlf included, or sh rejects them
*.sh text eol=lf

# Read by Linux tools from this tree (the linux skill syncs a Windows
# checkout into WSL): a CR ends linuxdeploy's Icon= value and pkg-config's
# Libs with a stray byte
*.desktop text eol=lf
*.pc.in text eol=lf

# A recording's header names the SHA-256 of these copies: their bytes are
# checked out as committed, never with a Windows checkout's CRLF
tests/fixtures/recording/*/conditions.json -text
tests/fixtures/recording/*/signals.json -text

# The vehicle book in both formats and the signal files it names, read
# byte for byte: a file is named by the SHA-256 of its bytes
tests/data/vehiclebook/* -text
tests/data/vehiclebook/signals/* -text

# Layout files are read byte for byte, so a checkout never rewrites their line endings
tests/data/layouts/* -text
tests/fixtures/layouts/* -text

# Another project's files, kept byte for byte as it published them
# (scripts/vendor_wamr.sh --check compares them)
third_party/wamr/** -text
# The patches the script applies to them: git apply needs their line
# ends as written
third_party/wamr-patches/** -text
