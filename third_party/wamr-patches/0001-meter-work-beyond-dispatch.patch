+
 #include "wasm_interp.h"
 #include "bh_log.h"
 #include "wasm_runtime.h"
@@ -602,6 +608,8 @@ wasm_interp_get_frame_ref(WASMInterpFrame *frame)
         frame_sp = (frame_csp - 1)->frame_sp;                          \
