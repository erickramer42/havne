                             (frame_csp - 1)->begin_addr, (uint8 *)-1,
@@ -2232,6 +2280,12 @@ wasm_interp_call_func_bytecode(WASMModuleInstance *module,
                         wasm_set_exception(module, "find block address failed");
                         goto got_exception;
                     }
+#if WASM_ENABLE_INSTRUCTION_METERING != 0
