// File/layer: packaging/windows/version.rc.in | Windows resource template
// Testing: manual: the built exe's Details in Explorer, or
//          (Get-Item <exe>).VersionInfo; stage.ps1 checks each packaged
//          exe's ProductVersion against the release's version
//
// The version resource of each Windows executable Havne ships:
// Explorer's Details tab shows it, and code signing reads it. Filled in
// by app_add_version_resource() (root CMakeLists.txt) from
// project(Havne VERSION ...), the one source of the version, and, for
// havne.exe, its icon (app/windows/app.ico, from make_icons.py).

#include <winver.h>

@APP_RC_ICON@

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @Havne_VERSION_MAJOR@,@Havne_VERSION_MINOR@,@Havne_VERSION_PATCH@,0
 PRODUCTVERSION @Havne_VERSION_MAJOR@,@Havne_VERSION_MINOR@,@Havne_VERSION_PATCH@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "@APP_RC_DESCRIPTION@"
            VALUE "FileVersion", "@Havne_VERSION@"
            VALUE "InternalName", "@APP_RC_NAME@"
            VALUE "LegalCopyright", "Copyright (c) 2026 Eric Kramer. MIT License."
            VALUE "OriginalFilename", "@APP_RC_NAME@.exe"
            VALUE "ProductName", "Havne"
            VALUE "ProductVersion", "@Havne_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
